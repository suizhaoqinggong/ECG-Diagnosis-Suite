# 后端环境变量配置模板
# 复制此文件为 .env 并填写实际值

# 应用配置
APP_NAME=ECG Diagnosis Suite
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ecg_db
# 或使用SQLite（开发环境）
# DATABASE_URL=sqlite+aiosqlite:///./ecg_db.sqlite

# Redis配置（可选）
REDIS_URL=redis://localhost:6379/0

# 文件上传配置
MAX_UPLOAD_SIZE=10485760  # 10MB
UPLOAD_DIR=./data/uploads
ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.dicom

# AI模型配置
MODEL_PATH=./models/weights/ecg_model.pth
ONNX_MODEL_PATH=./models/weights/ecg_model.onnx
DEVICE=cpu  # 或 cuda
CONFIDENCE_THRESHOLD=0.7

# PDF报告配置
REPORT_OUTPUT_DIR=./data/reports
REPORT_TEMPLATE_DIR=./templates

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 安全配置
ALLOWED_HOSTS=localhost,127.0.0.1
