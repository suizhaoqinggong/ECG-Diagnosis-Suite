# Backend environment configuration template
# Copy this file to .env and fill in actual values

# App settings
APP_NAME=ECG Diagnosis Suite
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production
API_DOCS_ENABLED=True

# Server settings
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Database settings (MySQL for production)
DATABASE_URL=mysql+asyncmy://ecg:ecg123456@127.0.0.1:3306/ecg_db
# Or use SQLite for development
# DATABASE_URL=sqlite+aiosqlite:///./ecg_db.sqlite

# File upload settings
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=data/uploads
ALLOWED_EXTENSIONS=[".png", ".jpg", ".jpeg", ".dat", ".hea"]

# Model settings
MODEL_CHECKPOINT_PATH=models/checkpoints/best.ckpt
DEVICE=cpu
CONFIDENCE_THRESHOLD=0.7
MODEL_TEMPERATURE=0.5
MODEL_NORMAL_BIAS=1.8

# Report settings
REPORT_OUTPUT_DIR=data/reports
LLM_REPORT_ENABLED=False
LLM_REPORT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REPORT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
ANTHROPIC_COMPAT_API_KEY=
ANTHROPIC_COMPAT_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_COMPAT_MODEL=glm-5
ANTHROPIC_COMPAT_MAX_TOKENS=2048
ANTHROPIC_COMPAT_TIMEOUT_SECONDS=30

# CORS settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
